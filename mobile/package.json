{
  "name": "crewsignal-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "CrewSignal packaged iOS and Android prototype (Expo / React Native / TypeScript / expo-sqlite).",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "export": "expo export --platform ios --platform android --output-dir dist",
    "prebuild:android": "expo prebuild --platform android --no-install"
  },
  "dependencies": {
    "expo": "58.0.25",
    "expo-asset": "~58.0.21",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-print": "~58.0.9",
    "expo-sharing": "~58.0.23",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@testing-library/react-native": "14.1.0",
    "babel-preset-expo": "~58.0.25",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.14",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  }
}
