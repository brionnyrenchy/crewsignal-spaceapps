{
  "name": "@crewsignal/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Canonical shared TypeScript contracts, domain logic, fixtures, design tokens, bundled fonts, and acceptance vectors for CrewSignal.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./tokens/tokens.css",
    "./tokens.json": "./tokens/tokens.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:check": "node ./scripts/sync-to-targets.mjs --check"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
